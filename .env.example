# Database
DATABASE_URL=postgresql://jobapp:jobapp@postgres:5432/jobapp
TEST_DATABASE_URL=postgresql://jobapp:jobapp@postgres:5432/jobapp_test

# Redis
REDIS_URL=redis://redis:6379/0

# LLM - NVIDIA NIM (OpenAI-compatible)
NVIDIA_NIM_API_KEY=your_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash
# Output ceiling per matching call. Generous because the default model reasons
# before answering — a ceiling sized for the JSON alone truncates it mid-object
# and the parse fails, which looks like the model being bad at the task.
NIM_MATCH_MAX_TOKENS=1536

# Optional extra LLM providers. With a key set, resume/cover-letter generation
# prefers Claude, then Gemini, then NIM; job matching stays on free NIM and
# uses these only as failover (cheap models, hard per-cycle cap).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8          # generation: opus-4-8 ~$0.11/application; claude-sonnet-5 ~$0.04
ANTHROPIC_MATCH_MODEL=claude-haiku-4-5   # matching failover: cheap JSON scoring
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_PAID_MATCH_CALLS_PER_CYCLE=150       # hard cap on paid matching calls per cycle

# Outreach. Contact discovery works with nothing configured (it reads the
# posting and derives the company's address pattern); a Hunter key turns it
# from guesses into real, verifiable addresses.
OUTREACH_ENABLED=true
HUNTER_IO_API_KEY=              # free tier: hunter.io — 25 searches/month
OUTREACH_MAX_CONTACTS_PER_APP=5

# Contact sources, in the order discovery trusts them. All optional, and the
# first two need no key or quota at all:
#   the posting      — addresses printed in the job description
#   team pages       — LinkedIn profile links + published addresses on /team, /about
#   Hunter           — real people, but a sales-oriented dataset and 25 lookups/month free
#   GitHub           — public org members: named engineers, best source for referral asks
#   LinkedIn scrape  — see the warning below
OUTREACH_USE_TEAM_PAGES=true
OUTREACH_USE_GITHUB=true
GITHUB_TOKEN=                   # a classic token with no scopes is enough; lifts 60/hr to 5000/hr

# The LinkedIn people search is an authenticated scrape from this server's IP,
# which is the pattern LinkedIn restricts accounts for. The "Find people on
# LinkedIn" links in the app reach the same profiles through your own browser
# with no account risk, so leave this off unless you accept that trade.
OUTREACH_USE_LINKEDIN=false     # needs LINKEDIN_SESSION_COOKIE and a browser launch
OUTREACH_LINKEDIN_MAX_SEARCHES=1  # per discovery run; risk scales with volume
OUTREACH_TARGET_TITLES=technical recruiter,talent acquisition,engineering manager,hiring manager
OUTREACH_GUESS_EMAILS=true      # derive first.last@company.com when nobody hands us an address
OUTREACH_VERIFY_EMAILS=false    # spend a Hunter verifier credit per discovered address
OUTREACH_FOLLOWUP_DAYS=4,7,10   # days after sending that each follow-up comes due
OUTREACH_AUTO_DRAFT_FOLLOWUPS=true   # drafts only — nothing is ever sent unattended
OUTREACH_FOLLOWUP_INTERVAL_HOURS=6

# Sending. Off until BOTH the flag is on and an SMTP host is set, so a
# half-configured deploy cannot mail anyone. Without it, drafts are still
# copied out or opened in your own mail client.
OUTREACH_SEND_ENABLED=false
OUTREACH_MAX_SENDS_PER_DAY=20
OUTREACH_ATTACH_DOCUMENTS=true  # attach the current tailored resume + cover letter
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                  # Gmail/Google Workspace: an app password, not your login
SMTP_USE_TLS=true               # STARTTLS on a submission port (587)
SMTP_USE_SSL=false              # implicit TLS instead (465); takes precedence
SMTP_FROM_EMAIL=                # defaults to your profile email
SMTP_FROM_NAME=                 # defaults to your profile name

# Reading the mailbox. This is what makes "they replied, stop chasing them" a
# mechanism instead of a habit — OUTREACH_AUTO_DRAFT_FOLLOWUPS is on by default,
# and without this the guard depends on you clicking a button. Bounces are also
# the only evidence that a guessed address is dead. Read-only: nothing is marked
# read, moved, or deleted.
IMAP_ENABLED=false
IMAP_HOST=                      # imap.gmail.com for Gmail/Workspace
IMAP_PORT=993
IMAP_USERNAME=                  # defaults to SMTP_USERNAME
IMAP_PASSWORD=                  # defaults to SMTP_PASSWORD (the same app password)
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=14           # how far the FIRST poll looks back; later polls resume
IMAP_MAX_MESSAGES_PER_POLL=200
IMAP_POLL_INTERVAL_MINUTES=15

# Job source API keys (all optional — leave blank to disable that source)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
JOOBLE_API_KEY=                # free key: jooble.org/api/about
FINDWORK_API_KEY=              # free key: findwork.dev/developers
CAREERJET_AFFID=               # free affiliate id: careerjet.com/partners
LINKEDIN_SESSION_COOKIE=
HANDSHAKE_SESSION_COOKIE=
GREENHOUSE_COMPANY_SLUGS=      # comma-separated slugs e.g. stripe,airbnb
LEVER_COMPANY_SLUGS=
ASHBY_COMPANY_SLUGS=
SMARTRECRUITERS_COMPANY_SLUGS=
WORKABLE_COMPANY_SLUGS=
RECRUITEE_COMPANY_SLUGS=
WORKDAY_TENANTS=               # tenant:host:site triples, e.g. nvidia:wd5:NVIDIAExternalCareerSite
ATS_AUTO_DISCOVERY=true        # learn company ATS boards from links in fetched jobs
ATS_SEED_COMPANIES=true        # include the verified seed list of well-known tech companies
ATS_SLUG_VALIDATION=true       # validate configured slugs against the ATS APIs and auto-fix
ATS_LIST_HARVEST=true          # harvest company slugs from community job lists (SimplifyJobs etc.)
#SLUG_HARVEST_URLS=            # override the default list URLs (comma-separated raw URLs)
ATS_BOARD_REGISTRY=true        # persist every discovered company board and rank it by actual yield
ATS_MAX_SLUGS_PER_ATS=300      # per-cycle slug budget per ATS (Workday/SmartRecruiters capped lower)
ATS_BOARD_FETCH_WORKERS=8      # concurrent per-company board fetches
ATS_BOARD_MAX_EMPTY_CYCLES=8   # retire a discovered board after this many cycles with no jobs

# Aggregators link to their own redirect page, not the employer. Following those
# yields the real apply URL and reveals the company's ATS board to discovery.
RESOLVE_APPLY_LINKS=true
LINK_RESOLVE_MAX_PER_CYCLE=400
LINK_RESOLVE_WORKERS=8
ATS_SNIFF_CAREER_SITES=true      # mine careers.acme.com pages for an embedded ATS board
ATS_SNIFF_MAX_HOSTS_PER_CYCLE=40

# Jobs stored before the board registry existed are mined once, on the first
# fetch cycle after deploy (or run `python -m app.tasks.backfill` by hand).
BOARD_BACKFILL_ON_START=true
BOARD_BACKFILL_MAX_LINKS=400
BOARD_BACKFILL_MAX_HOSTS=120
BOARD_BACKFILL_WORKERS=16

# LinkedIn guest API. It pages 10 results at a time, and jobs with no description
# are dropped by the skill filter, so these two caps set the real yield.
LINKEDIN_MAX_PAGES=5
LINKEDIN_RECENCY_HOURS=168     # 7 days; 0 disables the freshness filter
LINKEDIN_MAX_DETAIL_FETCHES=200  # description fetches per cycle (not per search)
LINKEDIN_DETAIL_WORKERS=4

# Adzuna pages 50 results at a time
ADZUNA_MAX_PAGES=3
ADZUNA_MAX_DAYS_OLD=7

# Authentication
# On by default. Leaving it on without setting APP_PASSWORD does NOT fall back
# to open access — the app serves 503 until it is configured, because a
# misconfigured deployment should not be indistinguishable from a working one.
# Only set false if the app is not reachable from the internet.
AUTH_ENABLED=true
# Web UI password. There is no username. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PASSWORD=
# Bearer token for /api/agent/* (browser extension, local agent). Separate from
# APP_PASSWORD so that revoking the agent does not lock you out of the UI.
AGENT_TOKEN=
SESSION_MAX_AGE_SECONDS=1209600

# Agent queue. The laptop leases work, runs it in your own browser, posts back.
AGENT_LEASE_SECONDS=120          # before an abandoned task returns to the queue
AGENT_POLL_MAX_WAIT_SECONDS=25   # long-poll ceiling; stays under Chrome's ~30s worker timeout
AGENT_TASK_TTL_HOURS=24          # when queued work stops being worth doing
AGENT_MAX_LEASE_BATCH=10
# Bare domain Caddy serves on, no scheme and no trailing slash, e.g. example.com
# Must already resolve to this machine before starting, or certificate issuance
# fails. www.<domain> is redirected to it automatically.
APP_DOMAIN=

# Restrict the login cookie to HTTPS. Leave true once TLS is in front of the app.
# Set false ONLY while still serving plain http:// — with it true over http, the
# browser takes the cookie at login and then refuses to send it back, which looks
# like an endless login loop rather than an error.
SESSION_COOKIE_SECURE=true
# Cross-origin callers, comma-separated. The extension's is chrome-extension://<id>.
CORS_ALLOW_ORIGINS=

# App
# Session cookies are signed with SECRET_KEY, so leaving it at the example value
# means anyone can forge a login. The app refuses to serve until it is changed.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
DEBUG=false
STORAGE_PATH=/storage
MIN_MATCH_SCORE=70
FETCH_INTERVAL_HOURS=5
MIN_KEYWORD_SKILLS=2
MAX_JOB_AGE_DAYS=30           # skip fetched jobs posted longer ago than this (0 disables)
FILTER_SENIOR_TITLES=true     # drop Senior/Staff/Principal/Lead titles for junior candidates
JUNIOR_MAX_YEARS=3.0          # "junior" means fewer than this many years of experience

# Wellfound is scraped via its role landing pages (wellfound.com/role/<slug>),
# a fixed taxonomy — comma-separated slugs. Role pages aren't location-filtered.
WELLFOUND_ROLES=software-engineer,full-stack-engineer,backend-engineer,mobile-engineer
WELLFOUND_ENABLED=true        # set false if Wellfound stays blocked (saves a browser launch)
