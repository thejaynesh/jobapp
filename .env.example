# Database
DATABASE_URL=postgresql://jobapp:jobapp@postgres:5432/jobapp
TEST_DATABASE_URL=postgresql://jobapp:jobapp@postgres:5432/jobapp_test
# Connection pool. Bigger than SQLAlchemy's 5 + 10 default because the browser
# agent long-polls and HTMX fragments refresh independently of their page.
# `/health` and the System panel on /runs both report how much is in use.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://redis:6379/0

# LLM - NVIDIA NIM (OpenAI-compatible)
NVIDIA_NIM_API_KEY=your_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=z-ai/glm-5.2
# Output ceiling per matching call. Generous because the default model reasons
# before answering — a ceiling sized for the JSON alone truncates it mid-object
# and the parse fails, which looks like the model being bad at the task.
NIM_MATCH_MAX_TOKENS=1536

# Every LLM request and reply, stored together and readable at /llm. The old
# log lines said a call happened and how it ended — which the result already
# tells you. The pair is what answers "was the prompt wrong or the answer".
LLM_LOG_ENABLED=true
LLM_LOG_MAX_CHARS=20000        # per field; prompts carry whole job descriptions
LLM_LOG_KEEP_ROWS=2000         # oldest beyond this are pruned
LLM_LOG_PRUNE_INTERVAL_HOURS=6

# FreeInference — OpenAI-compatible, free daily credit (freeinference.org).
# Tried BEFORE the paid providers in both chains: it cannot bill, and the chain
# already falls through on any failure, including the day's credit running out.
#
# It accepts ONE request at a time, and this app does not work one at a time —
# two Celery worker processes, and matching deliberately overlaps document
# generation. So calls to it queue through a Redis gate; a caller that waits
# too long for its turn falls through to the next provider instead of blocking
# a worker. Nothing else slows down: only calls to this endpoint serialise.
FREEINFERENCE_API_KEY=
FREEINFERENCE_BASE_URL=https://freeinference.org/v1
FREEINFERENCE_MODEL=glm-5.1            # documents — the user-facing writing
FREEINFERENCE_MATCH_MODEL=glm-5-turbo  # matching — high-volume JSON scoring
FREEINFERENCE_MAX_CONCURRENCY=1        # 0 disables the gate entirely

# Optional extra LLM providers. With a key set, resume/cover-letter generation
# prefers Claude, then Gemini, then NIM; job matching stays on free NIM and
# uses these only as failover (cheap models, hard per-cycle cap).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8          # generation: opus-4-8 ~$0.11/application; claude-sonnet-5 ~$0.04
ANTHROPIC_MATCH_MODEL=claude-haiku-4-5   # matching failover: cheap JSON scoring
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_PAID_MATCH_CALLS_PER_CYCLE=150       # hard cap on paid matching calls per cycle

# A second opinion on the jobs where the answer is in doubt. A fast model
# scores everything; a 20 is a 20 and a 95 is a 95 whoever reads them, but the
# band in the middle is where accept and reject flip — and where a cheap
# model's guess decides whether you ever see a job. Skipped entirely unless
# something stronger than the primary is configured.
DEEP_MATCH_ENABLED=true
DEEP_MATCH_BAND_LOW=55
DEEP_MATCH_BAND_HIGH=85
DEEP_MATCH_MAX_PER_CYCLE=100

# How much of a posting the scoring prompt carries. Was 4,000 characters, from
# when descriptions were 500-character stubs; now that enrichment fetches the
# real text that was cutting off mid-requirements.
MATCH_DESCRIPTION_CHARS=24000

# Outreach. Contact discovery works with nothing configured (it reads the
# posting and derives the company's address pattern); a Hunter key turns it
# from guesses into real, verifiable addresses.
OUTREACH_ENABLED=true
HUNTER_IO_API_KEY=              # free tier: hunter.io — 25 searches/month
OUTREACH_MAX_CONTACTS_PER_APP=5

# Contact sources, in the order discovery trusts them. All optional, and the
# first two need no key or quota at all:
#   the posting      — addresses printed in the job description
#   team pages       — LinkedIn profile links + published addresses on /team, /about
#   Hunter           — real people, but a sales-oriented dataset and 25 lookups/month free
#   GitHub           — public org members: named engineers, best source for referral asks
#   LinkedIn scrape  — see the warning below
OUTREACH_USE_TEAM_PAGES=true
OUTREACH_USE_GITHUB=true
GITHUB_TOKEN=                   # a classic token with no scopes is enough; lifts 60/hr to 5000/hr

# The LinkedIn people search is an authenticated scrape from this server's IP,
# which is the pattern LinkedIn restricts accounts for. The "Find people on
# LinkedIn" links in the app reach the same profiles through your own browser
# with no account risk, so leave this off unless you accept that trade.
OUTREACH_USE_LINKEDIN=false     # needs LINKEDIN_SESSION_COOKIE and a browser launch
OUTREACH_LINKEDIN_MAX_SEARCHES=1  # per discovery run; risk scales with volume
OUTREACH_TARGET_TITLES=technical recruiter,talent acquisition,engineering manager,hiring manager
OUTREACH_GUESS_EMAILS=true      # derive first.last@company.com when nobody hands us an address
OUTREACH_VERIFY_EMAILS=false    # spend a Hunter verifier credit per discovered address
OUTREACH_FOLLOWUP_DAYS=4,7,10   # days after sending that each follow-up comes due
OUTREACH_AUTO_DRAFT_FOLLOWUPS=true   # drafts only — nothing is ever sent unattended
OUTREACH_FOLLOWUP_INTERVAL_HOURS=6

# Sending. Off until BOTH the flag is on and an SMTP host is set, so a
# half-configured deploy cannot mail anyone. Without it, drafts are still
# copied out or opened in your own mail client.
OUTREACH_SEND_ENABLED=false
OUTREACH_MAX_SENDS_PER_DAY=20
OUTREACH_ATTACH_DOCUMENTS=true  # attach the current tailored resume + cover letter
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                  # Gmail/Google Workspace: an app password, not your login
SMTP_USE_TLS=true               # STARTTLS on a submission port (587)
SMTP_USE_SSL=false              # implicit TLS instead (465); takes precedence
SMTP_FROM_EMAIL=                # defaults to your profile email
SMTP_FROM_NAME=                 # defaults to your profile name

# Reading the mailbox. This is what makes "they replied, stop chasing them" a
# mechanism instead of a habit — OUTREACH_AUTO_DRAFT_FOLLOWUPS is on by default,
# and without this the guard depends on you clicking a button. Bounces are also
# the only evidence that a guessed address is dead. Read-only: nothing is marked
# read, moved, or deleted.
IMAP_ENABLED=false
IMAP_HOST=                      # imap.gmail.com for Gmail/Workspace
IMAP_PORT=993
IMAP_USERNAME=                  # defaults to SMTP_USERNAME
IMAP_PASSWORD=                  # defaults to SMTP_PASSWORD (the same app password)
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=14           # how far the FIRST poll looks back; later polls resume
IMAP_MAX_MESSAGES_PER_POLL=200
IMAP_POLL_INTERVAL_MINUTES=15

# Job source API keys (all optional — leave blank to disable that source)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
JOOBLE_API_KEY=                # free key: jooble.org/api/about
FINDWORK_API_KEY=              # free key: findwork.dev/developers
CAREERJET_AFFID=               # free affiliate id: careerjet.com/partners
# USAJOBS: the US federal government's official API. Free key, and the only
# source that states pay on every posting. BOTH fields are required — the API
# identifies callers by the registered email as well as by the key.
USAJOBS_API_KEY=               # free key: developer.usajobs.gov
USAJOBS_USER_AGENT=            # the email address you registered with
USAJOBS_MAX_PAGES=2
# hiring.cafe indexes ATS boards directly rather than other job boards, so its
# postings carry full descriptions and link at the employer.
HIRINGCAFE_ENABLED=true
# Y Combinator's public role pages — a fixed taxonomy, not search queries.
YC_ENABLED=true
YC_ROLES=                      # blank uses the built-in engineering role slugs

# A source failing every run for this many cycles is skipped instead of called
# again: an expired key answers identically forever. One probe still goes out
# every RETRY runs, so refreshing the key resumes it without re-enabling
# anything.
SOURCE_REST_AFTER_FAILURES=10
SOURCE_REST_RETRY_EVERY=10
LINKEDIN_SESSION_COOKIE=
HANDSHAKE_SESSION_COOKIE=
GREENHOUSE_COMPANY_SLUGS=      # comma-separated slugs e.g. stripe,airbnb
LEVER_COMPANY_SLUGS=
ASHBY_COMPANY_SLUGS=
SMARTRECRUITERS_COMPANY_SLUGS=
WORKABLE_COMPANY_SLUGS=
RECRUITEE_COMPANY_SLUGS=
# Each ATS we speak makes every company hosted on it reachable, and board
# discovery starts finding slugs for it automatically in job links and career
# pages — so leaving these empty is fine.
ICIMS_COMPANY_SLUGS=           # <slug>.icims.com or careers-<slug>.icims.com
BAMBOOHR_COMPANY_SLUGS=        # <slug>.bamboohr.com/careers
TEAMTAILOR_COMPANY_SLUGS=      # <slug>.teamtailor.com
JOBVITE_COMPANY_SLUGS=         # jobs.jobvite.com/<slug>
PERSONIO_COMPANY_SLUGS=        # <slug>.jobs.personio.de
WORKDAY_TENANTS=               # tenant:host:site triples, e.g. nvidia:wd5:NVIDIAExternalCareerSite
ATS_AUTO_DISCOVERY=true        # learn company ATS boards from links in fetched jobs
ATS_SEED_COMPANIES=true        # include the verified seed list of well-known tech companies
ATS_SLUG_VALIDATION=true       # validate configured slugs against the ATS APIs and auto-fix
ATS_LIST_HARVEST=true          # harvest company slugs from community job lists (SimplifyJobs etc.)
#SLUG_HARVEST_URLS=            # override the default list URLs (comma-separated raw URLs)
ATS_BOARD_REGISTRY=true        # persist every discovered company board and rank it by actual yield
ATS_MAX_SLUGS_PER_ATS=300      # per-cycle slug budget per ATS (Workday/SmartRecruiters capped lower)
ATS_BOARD_FETCH_WORKERS=8      # concurrent per-company board fetches
ATS_BOARD_MAX_EMPTY_CYCLES=8   # retire a discovered board after this many cycles with no jobs
# Discovery reads a slug out of a link and files it as a company, which is a
# guess. Probing before polling is what keeps `greenhouse/linkedin` and
# `greenhouse/appcast` from spending the budget real companies compete for.
ATS_BOARD_VALIDATION=true
ATS_BOARD_VALIDATE_PER_CYCLE=150

# Aggregators link to their own redirect page, not the employer. Following those
# yields the real apply URL and reveals the company's ATS board to discovery.
RESOLVE_APPLY_LINKS=true
# A 400/cycle budget left 79,705 links never resolved at all. Politeness per
# host is the real limit now; this only bounds how long one cycle can run.
LINK_RESOLVE_MAX_PER_CYCLE=5000
LINK_RESOLVE_WORKERS=16
LINK_RESOLVE_PER_HOST=4          # concurrent requests to any one host
LINK_RESOLVE_HOST_DELAY_MS=250   # minimum gap between requests to one host
ATS_SNIFF_CAREER_SITES=true      # mine careers.acme.com pages for an embedded ATS board
ATS_SNIFF_MAX_HOSTS_PER_CYCLE=40

# Jobs stored before the board registry existed are mined once, on the first
# fetch cycle after deploy (or run `python -m app.tasks.backfill` by hand).
BOARD_BACKFILL_ON_START=true
BOARD_BACKFILL_MAX_LINKS=400
BOARD_BACKFILL_MAX_HOSTS=120
BOARD_BACKFILL_WORKERS=16

# LinkedIn guest API. It pages 10 results at a time, and jobs with no description
# are dropped by the skill filter, so these two caps set the real yield.
LINKEDIN_MAX_PAGES=15
LINKEDIN_RECENCY_HOURS=168     # 7 days; 0 disables the freshness filter
# A politeness ceiling, not a ration: the title gate runs BEFORE these
# fetches now, so the budget is no longer spent on jobs it would reject.
LINKEDIN_MAX_DETAIL_FETCHES=2000
LINKEDIN_DETAIL_WORKERS=4

# Adzuna pages 50 results at a time
ADZUNA_MAX_PAGES=3
ADZUNA_MAX_DAYS_OLD=7

# Authentication
# On by default. Leaving it on without setting APP_PASSWORD does NOT fall back
# to open access — the app serves 503 until it is configured, because a
# misconfigured deployment should not be indistinguishable from a working one.
# Only set false if the app is not reachable from the internet.
AUTH_ENABLED=true
# Web UI password. There is no username. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PASSWORD=
# Bearer token for /api/agent/* (browser extension, local agent). Separate from
# APP_PASSWORD so that revoking the agent does not lock you out of the UI.
AGENT_TOKEN=
SESSION_MAX_AGE_SECONDS=1209600

# Agent queue. The laptop leases work, runs it in your own browser, posts back.
AGENT_LEASE_SECONDS=120          # before an abandoned task returns to the queue
AGENT_POLL_MAX_WAIT_SECONDS=25   # long-poll ceiling; stays under Chrome's ~30s worker timeout
AGENT_TASK_TTL_HOURS=24          # when queued work stops being worth doing
AGENT_MAX_LEASE_BATCH=10
# Bare domain Caddy serves on, no scheme and no trailing slash, e.g. example.com
# Must already resolve to this machine before starting, or certificate issuance
# fails. www.<domain> is redirected to it automatically.
APP_DOMAIN=

# Restrict the login cookie to HTTPS. Leave true once TLS is in front of the app.
# Set false ONLY while still serving plain http:// — with it true over http, the
# browser takes the cookie at login and then refuses to send it back, which looks
# like an endless login loop rather than an error.
SESSION_COOKIE_SECURE=true
# Cross-origin callers, comma-separated. The extension's is chrome-extension://<id>.
CORS_ALLOW_ORIGINS=

# App
# Session cookies are signed with SECRET_KEY, so leaving it at the example value
# means anyone can forge a login. The app refuses to serve until it is changed.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
DEBUG=false
STORAGE_PATH=/storage
MIN_MATCH_SCORE=70
FETCH_INTERVAL_HOURS=5         # the combined cycle, used by the manual trigger

# Fetching runs in three slices, each on its own schedule and its own lock.
# One 47-minute task used to fetch everything, so an API source that could
# refresh hourly ran on the cadence of a Chromium launch.
FETCH_API_INTERVAL_HOURS=2     # keyed APIs and public feeds — minutes per run
FETCH_BOARDS_INTERVAL_HOURS=5  # the company board registry, hundreds of slugs
FETCH_BROWSER_INTERVAL_HOURS=12  # Playwright: the expensive, least urgent tier
BROWSER_TIER_ENABLED=true      # switch the whole Playwright tier off

# Enrichment: going back to the employer's page for the description the source
# truncated (Adzuna cuts every one at 500 chars) or never sent (LinkedIn, 90%).
# Runs on its own schedule to drain the backlog, and at the end of each fetch
# so new jobs are scored on their real descriptions rather than on a stub.
ENRICH_ENABLED=true
ENRICH_MAX_PER_RUN=200           # per scheduled pass
ENRICH_INTERVAL_MINUTES=30
ENRICH_ON_FETCH=true
ENRICH_MAX_PER_FETCH=150         # per fetch-cycle tail-call
ENRICH_WORKERS=8
ENRICH_PER_HOST=4                # the only real budget: concurrency per host
ENRICH_HOST_DELAY_MS=400

# Matching cadence. Matching used to run only as a tail-call from a fetch, so
# anything one pass didn't finish waited hours for the next one — which looks
# exactly like matching being broken. It now sweeps on its own schedule, in
# bounded batches that re-queue themselves, so a restart loses one batch rather
# than the whole pass. The Pipeline panel on /runs shows what is still waiting.
MATCH_INTERVAL_MINUTES=20
MATCH_MAX_JOBS_PER_TASK=25
# A generation running longer than this had its worker killed; the sweeper
# re-queues those. Comfortably above generate_docs' own 5-minute time limit.
GENERATION_STUCK_MINUTES=20
MIN_KEYWORD_SKILLS=2
MAX_JOB_AGE_DAYS=30           # skip fetched jobs posted longer ago than this (0 disables)
FILTER_SENIOR_TITLES=true     # drop Senior/Staff/Principal/Lead titles for junior candidates
JUNIOR_MAX_YEARS=3.0          # "junior" means fewer than this many years of experience

# ---- Posting liveness ------------------------------------------------------
# Re-check matched/docs-generated jobs against the employer's page and badge
# the ones that closed. Conservative: only a 404/410, an explicit "no longer
# accepting applications" page, or a known ATS bouncing the job URL back to
# its board index counts — anything ambiguous leaves the job alone.
LIVENESS_ENABLED=true
LIVENESS_INTERVAL_HOURS=12    # how often a sweep runs
LIVENESS_MAX_PER_CYCLE=200    # postings checked per sweep
LIVENESS_WORKERS=8
LIVENESS_RECHECK_DAYS=3       # how long a verdict stands before re-checking

# Wellfound is scraped via its role landing pages (wellfound.com/role/<slug>),
# a fixed taxonomy — comma-separated slugs. Role pages aren't location-filtered.
WELLFOUND_ROLES=software-engineer,full-stack-engineer,backend-engineer,mobile-engineer
# Off by default: every Wellfound job ever stored came back without a
# description, and the attempt costs a Chromium launch. Set true to retry it.
WELLFOUND_ENABLED=false
# Dice search pages carry no descriptions (enrichment fetches them from the
# job-detail URLs). Set false to skip the scrape entirely.
DICE_ENABLED=true

# ---- Backups ---------------------------------------------------------------
# A gzipped pg_dump every night, on THIS MACHINE ONLY. It protects against a
# bad migration, a DROP in the wrong shell, or a container rebuilt with the
# volume detached — not against losing the box. See docs/BACKUPS.md.
# Needs postgresql-client in the image (added to the Dockerfile), so a rebuild
# is required before this can run.
BACKUP_ENABLED=true
BACKUP_DIR=/storage/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14                # two weeks of nightly dumps

# ---- Archiving old rejections ----------------------------------------------
# Settled rejections stop carrying their descriptions after this long. They are
# MOVED to `archived_jobs`, not deleted: deduplication reads three columns off
# the tombstone, and losing them means re-fetching and re-scoring the same
# posting forever. Never touches a job with an application, a job you rejected
# by hand, or anything not filtered_out.
ARCHIVE_ENABLED=true
ARCHIVE_AFTER_DAYS=60
ARCHIVE_MAX_PER_RUN=5000      # the first pass has a six-figure backlog
ARCHIVE_INTERVAL_HOURS=24

# ---- Language --------------------------------------------------------------
# Arbeitnow returns German listings under English titles, so the title gate
# passes them and a model is asked to score a posting you could not act on.
# Fails open: a posting whose language was never detected is always scored.
FILTER_BY_LANGUAGE=true
MATCH_LANGUAGES=en            # comma-separated ISO 639-1 codes

# ---- Document self-review --------------------------------------------------
# One critique call reads the whole draft against the job description and
# returns concrete objections; the existing rewriters then run again with those
# as feedback. Free calls, and generation is the only step whose output a human
# reads. Set false to go back to a single pass.
SELF_REVIEW_ENABLED=true

# Rewrites documents that were written before enrichment brought the real
# posting in. Only for applications still at `not_applied` — sent is sent.
DOC_REFRESH_ENABLED=true
DOC_REFRESH_INTERVAL_HOURS=6
DOC_REFRESH_MAX_PER_RUN=25

# ---- Browser-agent history -------------------------------------------------
# What the extension did, kept where it can be counted. Rows are small (a kind,
# a host, a few counts), so this keeps far more than the LLM log.
AGENT_EVENT_KEEP_ROWS=20000
AGENT_EVENT_PRUNE_INTERVAL_HOURS=12
# Finished browser tasks carry the page they brought back, which is the large
# part. Nothing pruned this table at all until the event log existed.
BROWSER_TASK_KEEP_DAYS=14

# How many past verdicts to keep per job. Per job rather than per table: the
# first evaluation is the one worth comparing against, and a global cap loses
# it within days.
SCORE_HISTORY_KEEP_PER_JOB=20
