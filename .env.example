# Database
DATABASE_URL=postgresql://jobapp:jobapp@postgres:5432/jobapp
TEST_DATABASE_URL=postgresql://jobapp:jobapp@postgres:5432/jobapp_test

# Redis
REDIS_URL=redis://redis:6379/0

# LLM - NVIDIA NIM (OpenAI-compatible)
NVIDIA_NIM_API_KEY=your_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Optional extra LLM providers. With a key set, resume/cover-letter generation
# prefers Claude, then Gemini, then NIM; job matching stays on free NIM and
# uses these only as failover (cheap models, hard per-cycle cap).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8          # generation: opus-4-8 ~$0.11/application; claude-sonnet-5 ~$0.04
ANTHROPIC_MATCH_MODEL=claude-haiku-4-5   # matching failover: cheap JSON scoring
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_PAID_MATCH_CALLS_PER_CYCLE=150       # hard cap on paid matching calls per cycle

# Outreach (optional)
HUNTER_IO_API_KEY=

# Job source API keys (all optional — leave blank to disable that source)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
JOOBLE_API_KEY=                # free key: jooble.org/api/about
FINDWORK_API_KEY=              # free key: findwork.dev/developers
CAREERJET_AFFID=               # free affiliate id: careerjet.com/partners
LINKEDIN_SESSION_COOKIE=
HANDSHAKE_SESSION_COOKIE=
GREENHOUSE_COMPANY_SLUGS=      # comma-separated slugs e.g. stripe,airbnb
LEVER_COMPANY_SLUGS=
ASHBY_COMPANY_SLUGS=
SMARTRECRUITERS_COMPANY_SLUGS=
WORKABLE_COMPANY_SLUGS=
RECRUITEE_COMPANY_SLUGS=
WORKDAY_TENANTS=               # tenant:host:site triples, e.g. nvidia:wd5:NVIDIAExternalCareerSite
ATS_AUTO_DISCOVERY=true        # learn company ATS boards from links in fetched jobs
ATS_SEED_COMPANIES=true        # include the verified seed list of well-known tech companies
ATS_SLUG_VALIDATION=true       # validate configured slugs against the ATS APIs and auto-fix
ATS_LIST_HARVEST=true          # harvest company slugs from community job lists (SimplifyJobs etc.)
#SLUG_HARVEST_URLS=            # override the default list URLs (comma-separated raw URLs)
ATS_BOARD_REGISTRY=true        # persist every discovered company board and rank it by actual yield
ATS_MAX_SLUGS_PER_ATS=300      # per-cycle slug budget per ATS (Workday/SmartRecruiters capped lower)
ATS_BOARD_FETCH_WORKERS=8      # concurrent per-company board fetches
ATS_BOARD_MAX_EMPTY_CYCLES=8   # retire a discovered board after this many cycles with no jobs

# Aggregators link to their own redirect page, not the employer. Following those
# yields the real apply URL and reveals the company's ATS board to discovery.
RESOLVE_APPLY_LINKS=true
LINK_RESOLVE_MAX_PER_CYCLE=400
LINK_RESOLVE_WORKERS=8
ATS_SNIFF_CAREER_SITES=true      # mine careers.acme.com pages for an embedded ATS board
ATS_SNIFF_MAX_HOSTS_PER_CYCLE=40

# LinkedIn guest API. It pages 10 results at a time, and jobs with no description
# are dropped by the skill filter, so these two caps set the real yield.
LINKEDIN_MAX_PAGES=5
LINKEDIN_RECENCY_HOURS=168     # 7 days; 0 disables the freshness filter
LINKEDIN_MAX_DETAIL_FETCHES=200  # description fetches per cycle (not per search)
LINKEDIN_DETAIL_WORKERS=4

# Adzuna pages 50 results at a time
ADZUNA_MAX_PAGES=3
ADZUNA_MAX_DAYS_OLD=7

# App
SECRET_KEY=change-me-in-production
DEBUG=false
STORAGE_PATH=/storage
MIN_MATCH_SCORE=70
FETCH_INTERVAL_HOURS=5
MIN_KEYWORD_SKILLS=2
MAX_JOB_AGE_DAYS=30           # skip fetched jobs posted longer ago than this (0 disables)
FILTER_SENIOR_TITLES=true     # drop Senior/Staff/Principal/Lead titles for junior candidates
JUNIOR_MAX_YEARS=3.0          # "junior" means fewer than this many years of experience
